{
  "$schema": "https://unpkg.com/wrangler@4.86.0/config-schema.json",
  // Redirect-only Worker: the site itself is deployed by Cloudflare Pages (see docs/DEPLOY.md).
  // Pages ignores this file because it has no pages_build_output_dir.
  "name": "shiftreplay",
  "main": "worker/redirect.js",
  "compatibility_date": "2026-10-24"
}
